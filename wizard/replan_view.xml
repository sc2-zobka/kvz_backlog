<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Form View For Forecast Wizard -->
	<record id="form_replan_wizard" model="ir.ui.view">
		<field name="name">replan.wizard.form</field>
        <field name="model">replan.wizard</field>
		<field name="arch" type="xml">
			<form string="Replanning">
				<group>
					<group>
						<field name="date" required="1"/>
					</group>
					<group>
					</group>
				</group>
				<footer>
					<button name="action_confirm" type="object" string="Confirm" class="oe_highlight" />
					<button special="cancel" type="object" string="Cancel" />
				</footer>
			</form>
		</field>
	</record>
	
	<!-- Action For Forecast Wizard -->
	<record id="action_replan_wizard" model="ir.actions.act_window">
		<field name="name">Replanning</field>
		<field name="res_model">replan.wizard</field>
		<field name="view_mode">form</field>
		<field name="view_id" ref="form_replan_wizard" />
		<field name="target">new</field>
	</record>
</odoo>