<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<!-- explicit list view definition -->
		<record model="ir.ui.view" id="backlog_list">
			<field name="name">backlog_tree</field>
			<field name="model">sale.order.line</field>
			<field name="arch" type="xml">
				<tree>
					<field name="project_manager" optional="hide" />
					<field name="order_partner_id" readonly="1" />
					<field name="country_id" readonly="1" optional="hide" />
					<field name="order_id" readonly="1" />
					<field name="service_id" optional="hide" />
					<field name="project_id" readonly="1" optional="hide" />
					<field name="name" readonly="1" />
					<field name="state" optional="hide" />
					<field name="backlog_state_id" optional="hide" />
					<field name="bklg_state" optional="hide" />
					<field name="date_deadline" optional="hide" />
					<field name="income_recognition_date" optional="hide" />
					<field name="company_id" column_invisible="True" />
					<field name="currency_id" optional="hide" />
					<field name="cpl_currency_id" readonly="1" optional="hide" />
					<field name="replanning_count" readonly="1" optional="hide" />
					<field name="amount_us" />
					<field name="price_total" />
					<field name="clp_price_total" widget="monetary" options="{'currency_field': 'cpl_currency_id'}" />
					<field name="invoice_status" optional="hide" />
					<!-- Invoicing Information -->
					<field name="invoice_number" optional="show" />
					<field name="real_invoiced_amount" optional="show" />
					<field name="real_invoice_total" optional="show" />
					<!-- Credit Note Information -->
					<field name="has_credit_note" column_invisible="True" />
					<field name="credit_note_number" optional="show" />
					<field name="credit_note_amount" optional="show" />
					<!-- Provision Information -->
					<field name="initial_provisioned_amount" optional="show" />
					<field name="initial_provisioned_amount_datetime" column_invisible="True" string="Fecha Provision Inicial" />

				</tree>
			</field>
		</record>

		<record id="kanban_sale_order_line_view" model="ir.ui.view">
			<field name="name">sale.order.line</field>
			<field name="model">sale.order.line</field>
			<field name="arch" type="xml">
				<kanban string="Backlog" edit="0" delete="0" default_group_by="backlog_state_id">
					<field name="clp_price_total" />
					<field name="cpl_currency_id" />
					<field name="activity_state" />
					<progressbar field="activity_state" colors='{"planned": "success", "today": "warning", "overdue": "danger"}'
						sum_field="clp_price_total" options="{'currency_field': 'cpl_currency_id'}" />
					<templates>
						<t t-name="kanban-box">
							<div class="oe_kanban_global_click" style="border-left:2px solid #00A09D;">
								<div>
									<strong class="o_kanban_record_title">
										<span style="font-size: 18px;">
											<field name="name" />
										</span>
									</strong>
									<p style="margin-bottom: 0rem;">Order : <field name="order_id" /></p>
									<p style="margin-bottom: 0rem;">Customer : <field name="order_partner_id" /></p>
								</div>
								<br />
								<div class="o_kanban_record_bottom">
									<div class="oe_kanban_bottom_left">
										<span>Forecast Date : <field name="forecast_date" />
										</span>
									</div>
									<div class="oe_kanban_bottom_right">
										<span>
											<field name="currency_id" invisible="1" /> Total : <field name="clp_price_total"
												widget="monetary" options="{'currency_field':'cpl_currency_id'}" />
										</span>
									</div>
								</div>
								<!-- <div class="o_kanban_record_bottom">
										<div class="oe_kanban_bottom_left text-muted">
											<p style="font-size: 11px;margin-bottom: 0rem;">
												
											</p>
										</div>
									</div> -->
							</div>
						</t>
					</templates>
				</kanban>
			</field>
		</record>


		<record id="form_sale_order_line_view" model="ir.ui.view">
			<field name="name">sale.order.line</field>
			<field name="model">sale.order.line</field>
			<field name="arch" type="xml">
				<form string="Gestion Backlog Kuvasz" delete="0" duplicate="0">
					<header>
						<button
							name="%(backlog.action_forecast_wizard)d"
							string="Forecast"
							type="action"
							class="oe_highlight"
							context="{'button':'forecast'}"
							groups="sales_team.group_sale_manager,sales_team.group_sale_salesman_all_leads,backlog.group_head_of_sales,backlog.group_business_owner"
							invisible="stages_type in ('forecast', 'planning', 'provisioned', 'invoiced')"
						/>
						<button
							name="action_unforecast"
							string="Unforecast"
							type="object"
							class="oe_highlight"
							context="{'button':'Unforecast'}"
							groups="sales_team.group_sale_manager,sales_team.group_sale_salesman_all_leads,backlog.group_head_of_sales"
							invisible="stages_type != 'forecast'"
						/>
						<button
							name="%(backlog.action_forecast_wizard)d"
							string="Send to Provision"
							type="action"
							context="{'button':'send_provisioning'}"
							class="oe_highlight"
							groups="backlog.group_business_owner,backlog.group_head_of_sales"
							invisible="stages_type != 'planning' or bklg_state in ('sent_to_provision', 'sent_to_invoicing')"
						/>
						<button
							name="action_provision"
							string="Provision"
							type="object"
							class="oe_highlight"
							groups="backlog.group_backlog_manager,account.group_account_invoice,account.group_account_manager,account.group_account_user"
							invisible="stages_type != 'planning'"
						/>
						<!-- <button
								name="action_invoice"
								string="Invoice"
								type="object"
								class="oe_highlight"
							groups="backlog.group_backlog_manager,account.group_account_invoice,account.group_account_manager,account.group_account_user"
								invisible="stages_type not in ('planning','provisioned')"
							/> -->
						<button
							name="action_reverse_provision"
							string="Reverse"
							type="object"
							class="btn-primary"
							groups="backlog.group_backlog_manager,account.group_account_invoice,account.group_account_manager,account.group_account_user"
							invisible="stages_type not in ('provisioned','invoiced')"
						/>
						<field name="backlog_state_id" widget="statusbar" clickable="True" />
						<field name="is_hide_forecast" invisible="1" />
						<field name="stages_type" invisible="1" />
					</header>
					<sheet>
						<div class="oe_title">
							<h1>
								<field name="name" readonly="1" />
							</h1>
						</div>
						<group>
							<group>
								<field name="project_manager" readonly="0" />
								<field name="order_partner_id" readonly="1" />
								<field name="country_id" readonly="1" />
								<field name="order_id" readonly="1" />
								<field name="service_id" readonly="1" invisible="1" />
								<field name="project_id" readonly="0" />
								<field name="user_id" />
								<field name="current_user_id" invisible="1" />
								<field name="product_id" />
								<field name="bklg_state" readonly="not current_user_id" context="{'manualy_change':True}" />
								<field name="product_template_id" string="Product" readonly="1" invisible="1" />
								<field name="product_id" string="Product Attributes"
									domain="[('product_tmpl_id','=',product_template_id)]" invisible="1" />
							</group>
							<group>
								<field name="forecast_date" readonly="1" invisible="1" />
								<field name="is_required_date" invisible="1" />
								<field name="date_deadline" readonly="bklg_state in ['forecast', 'provisioned', 'invoiced']"
									required="is_required_date" />

								<field name="price_subtotal" readonly="1" />
								<field name="amount_us" />
								<field name="cpl_currency_id" readonly="1" invisible="not forecast_date" />
								<field name="clp_price_total" readonly="1" widget="monetary"
									options="{'currency_field': 'cpl_currency_id'}" digits="[16, 0]" />
								<field name="clp_price_subtotal" readonly="1" widget="monetary"
									options="{'currency_field': 'cpl_currency_id'}" digits="[16, 0]" />


								<field name="replanning_count" readonly="1" />
								<field name="income_recognition_date" readonly="1" />
								<field name="state" readonly="1" invisible="1" />
								<field name="invoice_status" readonly="1" invisible="1" />
								<field name="currency_id" invisible="1" />
								<field name="company_id" invisible="1" />
							</group>
						</group>

						<group>
							<group string="Invoice Details">
								<!-- Invoicing Information -->
								<field name="invoice_number" />
								<field name="real_invoiced_amount" />
								<field name="real_invoice_total" />
								<!-- Credit Note Information -->
								<field name="has_credit_note" invisible="1" />
								<field name="credit_note_number" />
								<field name="credit_note_amount" />
							</group>
							<group string="Provision Details">
								<!-- Provision Information -->
								<field name="initial_provisioned_amount" />
								<field name="initial_provisioned_amount_datetime" string="Provision Date" readonly="1" />

							</group>
						</group>
					</sheet>
					<div class="oe_chatter">
						<field name="message_follower_ids" />
						<field name="activity_ids" />
						<field name="message_ids" options="{'post_refresh': 'recipients'}" />
					</div>
				</form>
			</field>
		</record>

		<!-- Make readonly fields for project_manager -->
		<record id="form_sale_order_line_view_inherit" model="ir.ui.view">
			<field name="name">sale.order.line.form.inherit</field>
			<field name="model">sale.order.line</field>
			<field name="inherit_id" ref="form_sale_order_line_view" />
			<field name="arch" type="xml">
				<field name="project_manager" position="attributes">
					<attribute name="readonly">1</attribute>
				</field>
				<field name="project_id" position="attributes">
					<attribute name="readonly">1</attribute>
				</field>
				<field name="product_id" position="attributes">
					<attribute name="readonly">1</attribute>
				</field>
				<field name="income_recognition_date" position="attributes">
					<attribute name="readonly">1</attribute>
				</field>
				<field name="replanning_count" position="attributes">
					<attribute name="readonly">1</attribute>
				</field>
				<xpath expr="//sheet/group/group/field[12]" position="attributes">
					<attribute name="readonly">1</attribute>
				</xpath>
			</field>
		</record>

		<record id="view_sale_order_line_graph_bar_type" model="ir.ui.view">
			<field name="name">sale.order.line.graph.legacy</field>
			<field name="model">sale.order.line</field>
			<field name="arch" type="xml">
				<graph string="Backlog (legacy)" type="bar" sample="1">
					<field name="clp_price_total" type="measure" />
					<field name="date_deadline" type="dimension" interval="month" />
					<field name="bklg_state" type="dimension" />
				</graph>
			</field>
		</record>


		<record id="view_backlog_graph_month_state" model="ir.ui.view">
			<field name="name">sale.order.line.graph.backlog.month_state</field>
			<field name="model">sale.order.line</field>
			<field name="arch" type="xml">
				<graph string="Backlog" type="bar" sample="1">
					<!-- MEDIDA (eje Y) -->
					<field name="clp_price_total" type="measure" />
					<!-- DIMENSIONES: 1) Mes (eje X)  2) Estado (apilado) -->
					<field name="date_deadline" type="dimension" interval="month" />
					<field name="bklg_state" type="dimension" />
					<field name="untaxed_amount_to_invoice" invisible="1" />
					<field name="untaxed_amount_invoiced" invisible="1" />
					<field name="product_uom_qty" invisible="1" />
					<field name="qty_to_invoice" invisible="1" />
					<field name="product_packaging_qty" invisible="1" />
					<field name="qty_delivered" invisible="1" />
					<field name="qty_invoiced" invisible="1" />
					<field name="discount" invisible="1" />
					<!---
					Revisar este campo en la migración 
				<field name="qty_delivered_manual" invisible="1"/>
				-->
					<field name="planning_hours_planned" invisible="1" />
					<field name="planning_hours_to_plan" invisible="1" />
					<field name="remaining_hours" invisible="1" />
					<field name="customer_lead" invisible="1" />
					<field name="price_reduce_taxinc" invisible="1" />
					<field name="price_reduce_taxexcl" invisible="1" />
					<field name="price_unit" invisible="1" />
					<!---
					Revisar este campo en la migración 
				<field name="price_reduce" invisible="1"/>
				-->
					<field name="replanning_count" invisible="1" />
					<field name="sequence" invisible="1" />
					<field name="price_subtotal" invisible="1" />
					<field name="price_total" invisible="1" />
					<field name="price_tax" invisible="1" />
				</graph>
			</field>
		</record>

		<!-- actions opening views on models -->
		<record model="ir.actions.act_window" id="backlog.action_window">
			<field name="name">Gestion Backlog Kuvasz</field>
			<field name="res_model">sale.order.line</field>
			<field name="view_mode">tree,kanban,form,graph</field>
			<field name="domain">[('state','in',['draft','sale','sent']),('display_type','=',False)]</field>
		</record>

		<!-- Search for graph -->
		<record model="ir.ui.view" id="view_sale_order_line_search_graph">
			<field name="name">sale.order.line.graph.search</field>
			<field name="model">sale.order.line</field>
			<field name="arch" type="xml">
				<search string="Backlog">
					<field name="order_id" />
					<field name="bklg_state" />
					<field name="date_deadline" />
					<filter string="Deadline Date" name="date_deadline" date="date_deadline" />
					<filter string="Hide undefined backlog state or deadline date records" name="hide_undefined"
						domain="['&amp;', ('bklg_state','!=',False), ('date_deadline','!=',False)]" />
				</search>
			</field>
		</record>

		<record id="backlog_report" model="ir.actions.act_window">
			<field name="name">Gestión Backlog Kuvasz</field>
			<field name="res_model">sale.order.line</field>
			<field name="view_mode">graph</field>
			<field name="view_id" ref="view_backlog_graph_month_state" />
			<field name="search_view_id" ref="view_sale_order_line_search_graph" />
			<field name="domain">[('state','in',['draft','sale','sent']), ('display_type','=',False),
				('date_deadline','!=',False)]</field>
			<field name="context">
				{
				"graph_mode": "bar",
				"graph_measure": "clp_price_total",
				"group_by": ["date_deadline:month", "bklg_state"],
				"search_default_hide_undefined": 1
				}
			</field>
		</record>


	</data>
</odoo>